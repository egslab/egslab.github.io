---
layout : page
---
{% assign groups = site.members | sort: "group_rank" | map: "group" | uniq %}
{% for group in groups %}

<h2> {{ group }} </h2>

    {% assign members = site.members | sort: "person_rank" | where: "group", group %}
    {% for member in members %}

<p>
    <div class="card {% if member.inline == false %}hoverable{% endif %}">
        <div class="row no-gutters">
            <div class="team col-sm-12">
                <div class="card-body">
                    {% if member.inline == false %}<a href="{{ member.url | relative_url }}">{% endif %}
                    <h4 class="card-title d-inline">{{ member.profile.name }}{% if member.profile.chinese_name %} ({{ member.profile.chinese_name }}){% endif %}</h4>
                    {% if member.profile.position %}<h6 class="card-subtitle mb-2 mr-2 text-muted d-inline">&nbsp;{{ member.profile.position }}{% if member.profile.time %} ({{ member.profile.time }}){% endif %}</h6>{% endif %}
                    {% if member.inline == false %}</a>{% endif %}
                    {% if member.profile.email %}
                        <a href="mailto:{{ member.profile.email }}" class="card-link"><i class="fas fa-envelope"></i></a>
                    {% endif %}
                    {% if member.profile.website %}
                        <a href="{{ member.profile.website }}" class="card-link" target="_blank"><i class="fas fa-globe"></i></a>
                    {% endif %}
                    {% if member.profile.github %}
                        <a href="https://github.com/{{ member.profile.github }}" class="card-link" target="_blank"><i class="fab fa-github"></i></a>
                    {% endif %}
                    {% if member.profile.orcid %}
                        <a href="https://orcid.org/{{ member.profile.orcid }}" class="card-link" target="_blank"><i class="fab fa-orcid"></i></a>
                    {% endif %}
                    {% if member.profile.twitter %}
                        <a href="https://twitter.com/{{ member.profile.twitter }}" class="card-link" target="_blank"><i class="fab fa-twitter"></i></a>
                    {% endif %}
                    {% if member.profile.phone %}
                        <a href="tel:{{ member.profile.phone }}" class="card-link"><i class="fas fa-phone"></i></a>
                    {% endif %}
                    {% if member.profile.linkedin %}
                        <a href="https://linkedin.com/in/{{ member.profile.linkedin }}/" class="card-link" target="_blank"><i class="fab fa-linkedin"></i></a>
                    {% endif %}
                    {% if member.profile.address %}
                        <p class="card-text">
                            <small class="test-muted"><i class="fas fa-thumbtack"></i> {{ member.profile.address | replace: '<br />', ', ' }}</small>
                        </p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</p>
    {% endfor %}
{% endfor %}
